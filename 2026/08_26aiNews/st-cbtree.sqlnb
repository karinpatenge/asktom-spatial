      \    SDO_WITHIN_DISTANCE(\r

      \      geom_start,\r

      \      geom,\r

      \      'distance=200, unit=M'\r

      \    ) = 'TRUE'\r

      \  AND distance_in_km BETWEEN 10 and 15;\r\n"
    languageId: oracle-sql
  - kind: 2
    value: "--\r

