  - kind: 1
    value: "**Using Optimizer Hint DOMAIN_INDEX_FILTER**\r

      \r

      The `/*+ DOMAIN_INDEX_FILTER(<table_name> <index_name>) */` hint is not
      required if optimizer statistics are available. This feature improves
      performance when spatial and scalar predicates are individually selective
      and become highly selective when evaluated together.\r

      \r

      You will next see an example for it."
    languageId: markdown
  - kind: 2
    value: >
      --

      -- Explain plan for counting trips with constructor as window and using
      DOMAIN_INDEX_FILTER hint

      --


      EXPLAIN PLAN FOR

      SELECT
        /*+ NO_RESULT_CACHE DOMAIN_INDEX_FILTER(citibike_tripdata citibike_tripdata_stidx) */ COUNT(*)
      FROM
        citibike_tripdata
      WHERE
        SDO_WITHIN_DISTANCE(
          geom_start,
          SDO_GEOMETRY(
            2002,
            4326,
            NULL,
            SDO_ELEM_INFO_ARRAY(1, 2, 1),
            SDO_ORDINATE_ARRAY(
              -73.9958982, 40.7265811, -73.9915495, 40.7317284, -73.990804, 40.7348668,
              -73.9900999, 40.7351492, -73.9891473, 40.7365614, -73.9903484, 40.7370949,
              -73.9888988, 40.7424296, -73.9885675, 40.7428062, -73.9891887, 40.7430886,
              -73.9882361, 40.7484542, -73.9886917, 40.7486425, -73.9879462, 40.7494583,
              -73.9873664, 40.7529723, -73.9864138, 40.7558273, -73.9869108, 40.7560783,
              -73.9846743, 40.7592156, -73.9850884, 40.7594665, -73.9824378, 40.7642348,
              -73.9816094, 40.7675912
            )
          ),
          'distance=200, unit=M'
        ) = 'TRUE'
        AND started_at BETWEEN
          TO_TIMESTAMP('2023-06-01 07:00:00.000','YYYY-MM-DD HH24:MI:SS.FF3')
          AND TO_TIMESTAMP('2023-06-01 11:00:00.000','YYYY-MM-DD HH24:MI:SS.FF3');

      SELECT *

      FROM TABLE(DBMS_XPLAN.DISPLAY);


      COMMIT;
    languageId: oracle-sql
  - kind: 2
    value: >
