  - kind: 1
    value: "## Using a Non-Temporal Column in the Enhanced CBTREE Index"
    languageId: markdown
  - kind: 2
    value: "--\r

      -- Drop indexes to start fresh\r

      --\r

      \r

      DROP INDEX IF EXISTS citibike_tripdata_sidx;\r

      DROP INDEX IF EXISTS citibike_tripdata_tidx;\r

      DROP INDEX IF EXISTS citibike_tripdata_stidx;\r

      DROP INDEX IF EXISTS citibike_tripdata_snidx;\r\n"
    languageId: oracle-sql
  - kind: 2
    value: "--\r

      -- Create a single enhanced CBTREE index that combines a spatial column
      with a non-spatial and non-temporal column\r

      --\r

      \r

      CREATE INDEX citibike_tripdata_snidx ON citibike_tripdata
      (geom_end)            -- Geometry column\r

      \  INDEXTYPE IS mdsys.spatial_index_v2\r

      \  FILTER BY
      distance_in_km                                                      --
      Number column\r

      \  PARAMETERS('cbtree_index=true layer_gtype=point
      sdo_point_field_only=true')\r

      \  PARALLEL 8;\r\n"
    languageId: oracle-sql
  - kind: 2
    value: "--\r

      -- Update table stats\r

      --\r

      \r

      BEGIN\r

      \  DBMS_STATS.GATHER_TABLE_STATS(\r

      \    'SANDBOX',\r

      \    'CITIBIKE_TRIPDATA',\r

      \    estimate_percent => DBMS_STATS.AUTO_SAMPLE_SIZE,\r

      \    degree => DBMS_STATS.AUTO_DEGREE,\r

      \    options => 'GATHER AUTO'\r

      \  );\r

      END;\r

      /\r

      \r

      BEGIN\r

      \  DBMS_STATS.GATHER_TABLE_STATS(\r

      \    'SANDBOX',\r

      \    'OSM_BROADWAY',\r

      \    estimate_percent => DBMS_STATS.AUTO_SAMPLE_SIZE,\r

      \    degree => DBMS_STATS.AUTO_DEGREE,\r

      \    options => 'GATHER AUTO'\r

      \  );\r

      END;\r

      /\r\n"
    languageId: oracle-sql
  - kind: 2
    value: "--\r

      -- Explain plan for counting trips with JOIN as window and
      DOMAIN_INDEX_FILTER hint\r

      --\r

      \r

      EXPLAIN PLAN FOR\r

      SELECT\r

      \  /*+ NO_RESULT_CACHE DOMAIN_INDEX_FILTER(citibike_tripdata
      citibike_tripdata_snidx) */ COUNT(*)\r

      FROM\r

      \  citibike_tripdata,\r

      \  osm_broadway\r

      WHERE\r

      \  id = 'test1'\r

      \  AND\r

      \    SDO_WITHIN_DISTANCE(\r

      \      geom_end,\r

      \      geom,\r

      \      'distance=200, unit=M'\r

      \    ) = 'TRUE'\r

      \  AND distance_in_km BETWEEN 10 and 15;\r

      \r

      SELECT *\r

      FROM TABLE(DBMS_XPLAN.DISPLAY);\r

      \r

      COMMIT;\r\n"
    languageId: oracle-sql
  - kind: 2
    value: "--\r

      -- Count trips with join as window and DOMAIN_INDEX_FILTER hint\r

      --\r

      \r

