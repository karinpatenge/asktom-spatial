  - kind: 1
    value: Adding another spatial dataset
    languageId: markdown
  - kind: 2
    value: "DESCRIBE osm_broadway\r\n"
    languageId: oracle-sql
  - kind: 2
    value: "--\r

      -- Show record count for the next query\r

      --\r

      \r

      SELECT\r

      \  COUNT(*)\r

      FROM\r

      \  osm_broadway\r

      WHERE\r

      \  id = 'test1'\r\n"
    languageId: oracle-sql
  - kind: 2
    value: "--\r

      -- Update table stats\r

      --\r

      \r

      BEGIN\r

      \  DBMS_STATS.GATHER_TABLE_STATS(\r

      \    'SANDBOX',\r

      \    'CITIBIKE_TRIPDATA',\r

      \    estimate_percent => DBMS_STATS.AUTO_SAMPLE_SIZE,\r

      \    degree => DBMS_STATS.AUTO_DEGREE,\r

      \    options => 'GATHER AUTO'\r

      \  );\r

      END;\r

      /\r

      \r

      BEGIN\r

      \  DBMS_STATS.GATHER_TABLE_STATS(\r

      \    'SANDBOX',\r

      \    'OSM_BROADWAY',\r

      \    estimate_percent => DBMS_STATS.AUTO_SAMPLE_SIZE,\r

      \    degree => DBMS_STATS.AUTO_DEGREE,\r

      \    options => 'GATHER AUTO'\r

      \  );\r

      END;\r

      /\r\n"
    languageId: oracle-sql
  - kind: 2
    value: >
      --

      -- Explain plan for counting trips with JOIN as window and no
      DOMAIN_INDEX_FILTER hint

      --


      EXPLAIN PLAN FOR

      SELECT
        /*+ NO_RESULT_CACHE */ COUNT(*)
      FROM
        citibike_tripdata,
        osm_broadway
      WHERE
        id = 'test1'
        AND
          SDO_WITHIN_DISTANCE(
            geom_start,
            geom,
            'distance=200, unit=M'
          ) = 'TRUE'
        AND started_at BETWEEN
          TO_TIMESTAMP('2023-06-01 07:00:00.000','YYYY-MM-DD HH24:MI:SS.FF3')
          AND TO_TIMESTAMP('2023-06-01 11:00:00.000','YYYY-MM-DD HH24:MI:SS.FF3');

      SELECT *

      FROM TABLE(DBMS_XPLAN.DISPLAY);


      COMMIT;
    languageId: oracle-sql
  - kind: 2
    value: >
      --

      -- Count trips with JOIN as window and no DOMAIN_INDEX_FILTER hint

      --


      SELECT
        /*+ NO_RESULT_CACHE */ COUNT(*)
      FROM
        citibike_tripdata,
        osm_broadway
      WHERE
        id = 'test1'
        AND
          SDO_WITHIN_DISTANCE(
            geom_start,
            geom,
            'distance=200, unit=M'
          ) = 'TRUE'
        AND started_at BETWEEN
          TO_TIMESTAMP('2023-06-01 07:00:00.000','YYYY-MM-DD HH24:MI:SS.FF3')
          AND TO_TIMESTAMP('2023-06-01 11:00:00.000','YYYY-MM-DD HH24:MI:SS.FF3');
    languageId: oracle-sql
  - kind: 2
    value: >
